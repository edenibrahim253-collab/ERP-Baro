   {"state": "Suspended", "doc_status": "1", "allow_edit": 0, "allow_cancel": 0, "is_optional": 0, "color": "Orange", "role": [{"role": "BARO Approver"}, {"role": "BARO Finance Approver"}]},
   {"state": "Deactivated", "doc_status": "1", "allow_edit": 0, "allow_cancel": 0, "is_optional": 0, "color": "Blue", "role": [{"role": "BARO Connectivity Admin"}]},
