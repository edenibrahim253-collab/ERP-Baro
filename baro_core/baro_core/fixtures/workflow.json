   {"state": "Suspended", "action": "Deactivate", "next_state": "Deactivated", "allowed": [{"role": "BARO Connectivity Admin"}], "allow_self_approval": 1, "visible": 1, "condition": "doc.baro_sim_status == 'Suspended'"}
  ]
 },
